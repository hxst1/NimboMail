# Maintainer: hxst1
pkgname=nimbomail-bin
_pkgname=nimbomail
pkgver=0.2.1
pkgrel=1
pkgdesc='Fast, minimal and private email client (IMAP/SMTP) with tracking protection, offline translation and calendar'
arch=('x86_64')
url='https://github.com/hxst1/NimboMail'
license=('GPL-3.0-or-later')
depends=('alsa-lib' 'gtk3' 'nss')
optdepends=('libnotify: desktop notifications')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!strip' '!debug')
source=("https://github.com/hxst1/NimboMail/releases/download/v$pkgver/NimboMail-$pkgver-x64.tar.gz"
        "$_pkgname.desktop")
sha256sums=('4972cba3b8c0e2d58639e6d3c429aff56db7c32ed0fead7433efb8fa618f4b28'
            '45e20d2e258f59fe511800cd3d7519502234db3091e4dff0d00f41ab21d4e4b6')

package() {
  install -d "$pkgdir/opt/$_pkgname"
  cp -a "NimboMail-$pkgver-x64/." "$pkgdir/opt/$_pkgname/"
  # Chromium sandbox on kernels without unprivileged user namespaces (linux-hardened…)
  chmod 4755 "$pkgdir/opt/$_pkgname/chrome-sandbox"

  install -d "$pkgdir/usr/bin"
  ln -s "/opt/$_pkgname/$_pkgname" "$pkgdir/usr/bin/$_pkgname"

  install -Dm644 "$_pkgname.desktop" "$pkgdir/usr/share/applications/$_pkgname.desktop"
  local res="$pkgdir/opt/$_pkgname/resources/app/resources"
  install -Dm644 "$res/$_pkgname.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_pkgname.svg"
  install -Dm644 "$res/$_pkgname.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/$_pkgname.png"
}
