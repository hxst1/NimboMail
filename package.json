{
  "name": "nimbomail",
  "version": "0.2.2",
  "private": true,
  "description": "Fast, minimal and private email client for Linux",
  "license": "GPL-3.0-or-later",
  "author": "hxst1",
  "homepage": "https://github.com/hxst1/NimboMail",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "demo": "electron-vite dev -- --demo",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "empaquetar": "electron-vite build && electron-builder --linux dir --publish never",
    "distribuir": "electron-vite build && electron-builder --linux AppImage tar.gz deb --publish never",
    "instalar": "bash scripts/instalar.sh",
    "install-app": "bash scripts/instalar.sh"
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "0.4.9",
    "dbus-next": "0.10.2",
    "imapflow": "^2.12.1",
    "mailparser": "^3.14.5",
    "nodemailer": "^10.6.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dompurify": "^3.4.18",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "virtua": "^0.54.2",
    "vite": "^8.3.8"
  },
  "productName": "NimboMail",
  "desktopName": "nimbomail.desktop",
  "build": {
    "appId": "io.github.hxst1.nimbomail",
    "productName": "NimboMail",
    "executableName": "nimbomail",
    "asar": false,
    "afterPack": "scripts/despues-de-empaquetar.cjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Network;Email",
      "icon": "resources/nimbomail.png",
      "executableName": "nimbomail",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "synopsis": "Fast, minimal and private email client",
      "mimeTypes": [
        "x-scheme-handler/mailto"
      ],
      "desktop": {
        "entry": {
          "Name": "NimboMail",
          "GenericName": "Email",
          "StartupWMClass": "nimbomail",
          "Keywords": "email;mail;imap;smtp;calendar;correo;"
        }
      },
      "maintainer": "hxst1 <hxst1@users.noreply.github.com>"
    },
    "deb": {
      "packageName": "nimbomail",
      "artifactName": "${name}_${version}_amd64.${ext}",
      "appArmorProfile": "packaging/deb/apparmor-profile.tpl"
    }
  }
}
